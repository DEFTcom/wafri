# اتصال قاعدة البيانات — محلياً Postgres مضمّن، بالإنتاج رابط Neon/Supabase الحقيقي
DATABASE_URL=postgres://care:care_local_dev@localhost:5432/care_compare

# مفتاح Claude API — مطلوب لخطوة المطابقة الذكية فقط (السحب يشتغل بدونه)
ANTHROPIC_API_KEY=

# لوحة الإدارة — لازم كلمة قوية عشوائية بالإنتاج، ما تُستخدم القيمة الافتراضية أبداً
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# دومين الموقع الفعلي — يُستخدم بكل الروابط والـ canonical والـ sitemap
SITE_URL=http://localhost:3000

# رمز حماية سحب الأسعار اليومي عبر Vercel Cron (راجعي vercel.json + src/app/api/cron/scrape)
CRON_SECRET=change-me-to-a-long-random-string
